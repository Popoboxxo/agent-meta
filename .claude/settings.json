{
  "permissions": {
    "allow": [],
    "deny": []
  },
  "mcpServers": {
    "honcho": {
      "type": "sse",
      "url": "${MCP_HONCHO_URL}"
    },
    "viz-logger": {
      "type": "stdio",
      "command": "python",
      "args": [
        "scripts/viz-logger.py",
        "--mcp"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/dod-push-check.sh"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/orchestrator-guard.sh"
          }
        ],
        "matcher": "\"\""
      }
    ]
  }
}
