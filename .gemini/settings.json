{
  "permissions": {
    "allow": [],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .gemini/hooks/viz-log.sh"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "viz-logger": {
      "type": "stdio",
      "command": "python",
      "args": [
        "scripts/viz-logger.py",
        "--mcp"
      ]
    }
  }
}
