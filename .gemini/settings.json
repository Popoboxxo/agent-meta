{
  "theme": "Default",
  "selectedAuthType": "oauth-personal",
  "hooks": {
    "BeforeTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .gemini/hooks/orchestrator-guard.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .gemini/hooks/viz-log.sh"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "viz-logger": {
      "type": "stdio",
      "command": "python",
      "args": [
        "scripts/viz-logger.py",
        "--mcp"
      ]
    }
  }
}
