{
  "theme": "Default",
  "selectedAuthType": "oauth-personal",
  "hooks": {},
  "mcpServers": {
    "honcho": {
      "type": "sse",
      "url": "${MCP_HONCHO_URL}",
      "headers": {
        "X-API-Key": "${MCP_HONCHO_API_KEY}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "viz-logger": {
      "type": "stdio",
      "command": "python",
      "args": [
        "scripts/viz-logger.py",
        "--mcp"
      ]
    }
  }
}
