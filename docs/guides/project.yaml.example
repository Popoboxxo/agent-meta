# Example: Orchestrator Configuration in project.yaml
# Add this block to your .meta-config/project.yaml to configure
# the Orchestrator-First Architecture behavior.

# ============================================================
# ORCHESTRATOR CONFIGURATION (Beta — Orchestrator-First v3.0.0)
# ============================================================

orchestrator:
  # enabled: true  → Orchestrator is active (default)
  # enabled: false → Main-Chat mode, no orchestration
  enabled: true

  # strict: true  → Always delegate, unknown intents → meta-feedback
  # strict: false → Fallback to main-chat for unknown intents
  strict: true

  # unknown-fallback: Granular flags for unknown intent handling
  #   meta-feedback: true → Send anonymized feedback to agent-meta (default: true)
  #   main-chat: true     → Allow main chat to handle the task (default: true)
  #   ask-user: false     → Ask user for preference (default: false)
  unknown-fallback:
    meta-feedback: true
    main-chat: true
    ask-user: false

  # native-extensions.enabled: Exempt platform-native extension mechanisms
  #   (Skills, Plugins, Lifecycle-Hooks) from the STRICT-mode orchestrator gate.
  #   true  → platform-triggered flows (e.g. a SessionStart hook loading a skill)
  #           are not treated as a delegation bypass (default)
  #   false → disable native extensions; their instructions stay informative only
  #   Note: branch-guard, commit-conventions and DoD still apply to resulting changes.
  native-extensions:
    enabled: true

# ============================================================
# PARALLEL EXECUTION
# ============================================================

# Maximum number of agents that can run simultaneously
# Default: 2 (conservative) | Recommended for dev: 4
max-parallel-agents: 4

# ============================================================
# MEMORY CONFIGURATION
# ============================================================
# memory.enabled: Master kill-switch for all memory fields.
#   true  → memory: fields generated per role-defaults + memory-overrides (default)
#   false → ALL memory: fields suppressed during sync — agents get no persistent memory
# memory.default_scope: Fallback scope for roles without explicit memory config.
#   ""        → no memory: field injected unless explicitly configured (default)
#   "project" → .claude/agent-memory/<role>/ (committed to git)
#   "local"   → .claude/agent-memory-local/<role>/ (gitignored)
#   "user"    → ~/.claude/agent-memory/<role>/ (machine-local)

# memory:
#   enabled: true
#   default_scope: ""

# ============================================================
# TEST REPOSITORY VALIDATION
# ============================================================
# Enables validation of sync output against a separate test repository.
# Use --validate flag to run a sync into the test repo and check for errors.
#
# Path resolution order:
#   1. AGENT_META_TEST_REPO environment variable (highest priority)
#   2. test-repo.path (relative to workspace or absolute)
#
# Usage:
#   python scripts/sync.py --validate
#   python scripts/sync.py --dry-run --validate
#
# If the test repo doesn't exist, validation fails with a clear error message.

test-repo:
  enabled: true
  path: "../agent-meta-test"          # relative to workspace root
  env-var: "AGENT_META_TEST_REPO"     # optional: env var override

# ============================================================
# EXAMPLE: Full project.yaml with Orchestrator-First
# ============================================================

# agent-meta-version: 0.53.1
#
# provider-isolation: disabled
