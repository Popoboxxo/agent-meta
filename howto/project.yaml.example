# Example: Orchestrator Configuration in project.yaml
# Add this block to your .meta-config/project.yaml to configure
# the Orchestrator-First Architecture behavior.

# ============================================================
# ORCHESTRATOR CONFIGURATION (Beta — Orchestrator-First v3.0.0)
# ============================================================

orchestrator:
  # enabled: true  → Orchestrator is active (default)
  # enabled: false → Main-Chat mode, no orchestration
  enabled: true

  # strict: true  → Always delegate, unknown intents → meta-feedback
  # strict: false → Fallback to main-chat for unknown intents
  strict: true

  # unknown-fallback: What to do when intent cannot be classified
  #   - "meta-feedback" → Send anonymized feedback to agent-meta (default for strict)
  #   - "main-chat"     → Let main chat handle it (default for relaxed)
  #   - "ask-user"      → Ask user: "Here or feedback?"
  unknown-fallback: meta-feedback

# ============================================================
# PARALLEL EXECUTION
# ============================================================

# Maximum number of agents that can run simultaneously
# Default: 2 (conservative) | Recommended for dev: 4
max-parallel-agents: 4

# ============================================================
# EXAMPLE: Full project.yaml with Orchestrator-First
# ============================================================

# agent-meta-version: 0.47.0
