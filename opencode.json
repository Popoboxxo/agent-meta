{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "rtk-for-opencode"
  ],
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "@playwright/mcp@latest",
          "--browser",
          "chromium"
        ]
      },
      "reqogniloom": {
        "type": "remote",
        "url": "{env:MCP_REQOGNILOOM_URL}/mcp/sse/",
        "headers": {
          "Authorization": "Bearer {env:MCP_REQOGNILOOM_API_KEY}",
          "X-Project-ID": "{env:MCP_REQOGNILOOM_PROJECT_ID}",
          "X-User-ID": "{env:MCP_REQOGNILOOM_USER_ID}",
          "X-Workspace-ID": "{env:MCP_REQOGNILOOM_WORKSPACE_ID}"
        }
      },
      "viz-logger": {
        "type": "local",
        "command": [
          "python3",
          "scripts/viz-logger.py",
          "--mcp"
        ]
      }
    }
  },
  "default_agent": "orchestrator",
  "permissions": [
    {
      "action": "edit",
      "resource": "**",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "**",
      "effect": "deny"
    }
  ],
  "experimental": {
    "subagent_depth": 3
  }
}
