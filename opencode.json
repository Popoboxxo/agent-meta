{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 3,
  "mcp": {
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ]
    },
    "reqflow": {
      "type": "remote",
      "enabled": true,
      "url": "{env:MCP_REQFLOW_URL}/mcp/sse/",
      "headers": {
        "X-API-Key": "{env:MCP_REQFLOW_API_KEY}"
      }
    },
    "viz-logger": {
      "type": "local",
      "enabled": true,
      "command": [
        "python",
        "scripts/viz-logger.py",
        "--mcp"
      ]
    }
  }
}
