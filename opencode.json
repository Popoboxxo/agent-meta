{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 3,
  "mcp": {
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ]
    },
    "viz-logger": {
      "type": "local",
      "enabled": true,
      "command": [
        "python",
        "scripts/viz-logger.py",
        "--mcp"
      ]
    }
  }
}
