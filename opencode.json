{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 3,
  "plugin": [
    "rtk-for-opencode"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--browser",
        "chromium"
      ]
    },
    "reqogniloom": {
      "type": "remote",
      "enabled": true,
      "url": "{env:MCP_REQOGNILOOM_URL}/mcp/sse/",
      "headers": {
        "Authorization": "Bearer {env:MCP_REQOGNILOOM_API_KEY}",
        "X-Project-ID": "{env:MCP_REQOGNILOOM_PROJECT_ID}",
        "X-User-ID": "{env:MCP_REQOGNILOOM_USER_ID}",
        "X-Workspace-ID": "{env:MCP_REQOGNILOOM_WORKSPACE_ID}"
      }
    },
    "viz-logger": {
      "type": "local",
      "enabled": true,
      "command": [
        "python",
        "scripts/viz-logger.py",
        "--mcp"
      ]
    }
  }
}
