{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      ".claude/**": "deny",
      "CLAUDE.md": "deny",
      ".continue/**": "deny",
      ".gemini/**": "deny"
    },
    "edit": {
      ".claude/**": "deny",
      "CLAUDE.md": "deny",
      ".continue/**": "deny",
      ".gemini/**": "deny"
    }
  },
  "mcp": {
    "viz-logger": {
      "type": "local",
      "enabled": true,
      "command": [
        "python",
        "scripts/viz-logger.py",
        "--mcp"
      ]
    }
  }
}
