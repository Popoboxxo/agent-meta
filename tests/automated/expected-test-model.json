      "title": "Sensor Data to Cloud with Privacy Filter",
      "components": ["COMP-001", "COMP-003", "COMP-014", "COMP-012", "COMP-011"],
      "flow": ["SIG-MOTION → COMP-003 → SIG-SENSOR-CLEAN → COMP-014 → SIG-ANONYMIZED-DATA → COMP-012 → SIG-COMPRESSED-DATA → COMP-011"],
      "validation": "No PII in cloud payload, bandwidth < 1 KB/hour, data arrives within 5s"
    },
    {
      "id": "IT-005",
      "title": "Self-Test Full System Diagnostic",
      "components": ["COMP-007", "COMP-001", "COMP-002", "COMP-008", "COMP-009"],
      "flow": ["SIG-SELFTEST-CMD → COMP-001/002/008/009 → SIG-SENSOR-STATUS/SIG-ACTUATOR-STATUS → COMP-007 → SIG-SELFTEST-RESULT"],
      "validation": "All 9 components tested within 10s, results reported locally and remotely"
    },
    {
      "id": "IT-006",
      "title": "OTA Update with Rollback on Failure",
      "components": ["COMP-011", "COMP-013", "COMP-004"],
      "flow": ["SIG-OTA-PACKAGE → COMP-013 → SIG-OTA-STATUS → COMP-004"],
      "validation": "Update installs correctly, simulated failure triggers rollback, local control never interrupted"
    },
    {
      "id": "IT-007",
      "title": "Error Code Propagation to Remote Diagnostics",
      "components": ["COMP-017", "COMP-016", "COMP-015", "COMP-011"],
      "flow": ["SIG-INTERNAL-ERROR → COMP-016 → SIG-STANDARD-ERROR-CODE → COMP-015 → SIG-DIAG-RESPONSE → COMP-011"],
      "validation": "Error code follows IEC 62056, appears in remote diagnostics within 5s, retained in 30-day history"
    }
