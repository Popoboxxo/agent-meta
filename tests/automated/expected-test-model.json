      "title": "Ambient Light to Dimmer Control Chain",
      "components": ["COMP-002", "COMP-003", "COMP-004", "COMP-010", "COMP-009"],
      "flow": ["SIG-LUX → COMP-003 → SIG-SENSOR-CLEAN → COMP-004 → SIG-LIGHT-CMD → COMP-010 → SIG-DIMMER-LEVEL → COMP-009"],
      "validation": "Brightness correctly mapped from lux input to dimmer output (10%-100% range)"
    },
    {
      "id": "IT-003",
      "title": "Cloud Outage Local Fallback",
      "components": ["COMP-001", "COMP-003", "COMP-006", "COMP-010", "COMP-008"],
